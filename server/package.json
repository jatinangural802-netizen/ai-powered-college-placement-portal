{
  "name": "careerbridge-server",
  "version": "1.0.0",
  "description": "CareerBridge API Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
